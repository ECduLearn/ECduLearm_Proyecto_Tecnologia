# Google Gemini API Key (Multi-Modelo Flash & Flash-Lite con balanceo automático de cuota)
# Si no se proporciona o no hay conexión, ECduLearm activa su modo offline socrático inquebrantable
VITE_GEMINI_API_KEY=tu_api_key_aqui

# Modo de Persistencia Desacoplada (apiAdapter)
# true: Opera al 100% en localStorage con datos semilla seedData.ts (Ideal para prototipo y evaluación offline)
# false: Conecta mediante peticiones REST al servidor backend de Joan
VITE_USE_MOCK_API=true

# URL base del Backend RESTful (cuando VITE_USE_MOCK_API sea false)
VITE_BACKEND_URL=http://localhost:3000/api

# Supabase PostgreSQL (Persistencia en la nube para sincronización entre dispositivos de aulas y PINs)
# Proyecto gratuito en https://supabase.com
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_publica_anonima_supabase
